# Server Configuration
PORT=5000

# MongoDB Connection String (Atlas URI or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/imovies?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/imovies

# JWT Secret for signing tokens (Use a long random string in production)
JWT_SECRET=imovies_super_secret_jwt_token_development_key_998822

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Default Admin Credentials for Seeding
ADMIN_EMAIL=admin@imovies.com
ADMIN_PASSWORD=Admin@12345
